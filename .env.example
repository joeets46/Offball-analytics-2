# Copy to .env and adjust. docker-compose.yml and the test suite both read it.
#
#     cp .env.example .env
#
# These are development-only values for a local container. Nothing here is a
# real credential, and .env itself is gitignored so a modified copy never gets
# committed.

# ---------------------------------------------------------------------------
# PostgreSQL 18 container
# ---------------------------------------------------------------------------
POSTGRES_DB=offball
POSTGRES_USER=offball
POSTGRES_PASSWORD=change-me-locally

# A high port on purpose. Both 5432 and 5433 are commonly occupied -- by a
# host PostgreSQL install, or another project's container. Connecting to the
# wrong server surfaces as `password authentication failed`, which gives no
# hint that the port was the problem, so the default avoids the collision
# rather than inviting it.
POSTGRES_PORT=55432
POSTGRES_HOST=localhost

# ---------------------------------------------------------------------------
# Derived connection string
# ---------------------------------------------------------------------------
# Used by tests/conftest.py and convenient for psql:
#
#     psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f models/physical/sql/00_create_all.sql
#
# Keep it consistent with the values above if you change them.
DATABASE_URL=postgresql://offball:change-me-locally@localhost:55432/offball

# ---------------------------------------------------------------------------
# Test behaviour
# ---------------------------------------------------------------------------
# There is no flag here. The database-backed tests always build the model from
# scratch, into a dedicated `offball_model_test` database, so a clean load is
# what every run actually proves -- and so a test run can never drop the
# database you are working in.
